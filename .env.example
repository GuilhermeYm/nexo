# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# Só usada pelos roteiros de ponta a ponta (bun run shots:*), para criar e
# apagar o usuário de teste. A aplicação em si nunca lê esta chave.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-somente-servidor

# Postgres connection string (usado pelo Drizzle)
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# Groq (classificação automática) — tem precedência sobre a OpenAI.
# A classificação roda dentro do caminho do upload, com o usuário esperando,
# e é por isso que a velocidade dele importa aqui.
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b
# Transcrição de áudio (opcional; padrão: whisper-large-v3-turbo).
# Usa a mesma GROQ_API_KEY acima e roda depois do upload.
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Leitura das notas escritas pelo usuário (resumo + tags), opcional.
# Marcar é mais fácil que resumir documento e aceita modelo menor.
# Sem a variável, usa o GROQ_MODEL.
# GROQ_NOTE_MODEL=

# OpenAI (classificação automática de documentos) — usada se não houver GROQ_API_KEY
# Sem nenhuma das duas, /api/attachments usa um stub determinístico (sem custo).
OPENAI_API_KEY=sk-...
# Modelo barato para classificação (ex.: gpt-4o-mini, gpt-5-nano)
OPENAI_MODEL=gpt-4o-mini
# Transcrição de áudio caso GROQ_API_KEY não esteja configurada.
# Padrão: gpt-4o-mini-transcribe.
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Leitura das notas (opcional). Sem a variável, usa o OPENAI_MODEL.
# OPENAI_NOTE_MODEL=

# Upstash Redis — rate limiting distribuído (opcional).
# Sem essas variáveis, lib/rate-limit.ts usa um limiter em memória
# (suficiente para dev local / instância única).
# UPSTASH_REDIS_REST_URL=https://seu-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=seu-token-do-upstash
