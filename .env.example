# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-somente-servidor

# Postgres connection string (usado pelo Drizzle)
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# Stripe (opcional até implementar pagamentos)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Groq (classificação automática) — tem precedência sobre a OpenAI.
# A classificação roda dentro do caminho do upload, com o usuário esperando,
# e é por isso que a velocidade dele importa aqui.
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b

# OpenAI (classificação automática de documentos) — usada se não houver GROQ_API_KEY
# Sem nenhuma das duas, /api/attachments usa um stub determinístico (sem custo).
OPENAI_API_KEY=sk-...
# Modelo barato para classificação (ex.: gpt-4o-mini, gpt-5-nano)
OPENAI_MODEL=gpt-4o-mini

# Upstash Redis — rate limiting distribuído (opcional).
# Sem essas variáveis, lib/rate-limit.ts usa um limiter em memória
# (suficiente para dev local / instância única).
# UPSTASH_REDIS_REST_URL=https://seu-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=seu-token-do-upstash
